umoniae","Listeria"],"a":2,"e":"Altered PBPs confer resistance."},{"q":"A vancomycin infusion reaction (diffuse flushing) is prevented by:","o":["Slower infusion and antihistamines","Probenecid","Adding gentamicin","Steroids only"],"a":0,"e":"Not an IgE allergy."}]},"cases":[{"id":"px-hiv","ch":"micro","title":{"th":"เพิ่งพบติดเชื้อ HIV","en":"A new HIV diagnosis"},"stem":{"th":"ชาย 29 ปี ตรวจพบ HIV จากการตรวจคัดกรอง CD4 180 cells/mm³ viral load สูง","en":"A 29-year-old man is diagnosed with HIV on screening; CD4 180 cells/mm³, high viral load."},"steps":[{"q":"Recommended initial regimen:","o":["Maraviroc alone","Integrase inhibitor + two NRTIs (e.g., bictegravir/tenofovir/emtricitabine)","Single NRTI","Protease inhibitor alone"],"a":1,"e":"Start ART promptly.","info":null,"t":"pharm-micro:hiv"},{"q":"Prophylaxis needed at this CD4 count:","o":["Azithromycin for MAC","TMP-SMX for Pneumocystis","Fluconazole for Cryptococcus","Ganciclovir for CMV"],"a":1,"e":"Start when CD4 < 200.","info":null,"t":"pharm-micro:prophylaxis"},{"q":"Test before use:","o":["HLA-B*57:01","G6PD","HLA-B*58:01","TPMT"],"a":0,"e":"Hypersensitivity risk.","info":{"th":"ถ้าจะใช้ abacavir","en":"If abacavir is considered"},"t":"pharm-micro:hiv"},{"q":"Tenofovir disoproxil requires monitoring for:","o":["Kidney function and bone density","Retinopathy","Lipodystrophy only","Pancreatitis"],"a":0,"e":"Tenofovir alafenamide has less renal/bone toxicity.","info":null,"t":"pharm-micro:hiv"}]}],"dx":[]}