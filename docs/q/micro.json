{"topics":{"pharm-micro:bactmap":[{"q":"Which class inhibits the 30S ribosomal subunit?","o":["Macrolides and clindamycin","Oxazolidinones and chloramphenicol","Lincosamides and streptogramins","Aminoglycosides and tetracyclines"],"a":3,"e":"Buy AT 30, CCEL at 50."},{"q":"Fluoroquinolones inhibit:","o":["Bacterial dihydrofolate reductase","DNA-dependent RNA polymerase","Cell wall transpeptidases (PBPs)","DNA gyrase and topoisomerase IV"],"a":3,"e":"Rifampin inhibits RNA polymerase."}],"pharm-micro:penicillin":[{"q":"β-lactamase inhibitors include:","o":["Probenecid, cilastatin, allopurinol","Vancomycin, daptomycin, telavancin","Clavulanate, sulbactam, tazobactam","Aztreonam, imipenem, cefepime"],"a":2,"e":"Combined with amoxicillin, ampicillin, piperacillin."},{"q":"Penicillinase-resistant penicillins (nafcillin, dicloxacillin) are used for:","o":["MRSA","Enterococcus","Pseudomonas","MSSA"],"a":3,"e":"Bulky side chain blocks β-lactamase."}],"pharm-micro:ceph":[{"q":"Which cephalosporin covers MRSA?","o":["Ceftaroline","Cefepime","Ceftriaxone","Cefazolin"],"a":0,"e":"5th generation; binds PBP2a."},{"q":"Aztreonam is safe in penicillin allergy because:","o":["It is a carbapenem, not a penicillin","It is given orally, avoiding sensitization","It is a monobactam with no cross-reactivity","It lacks a β-lactam ring and cannot bind PBPs"],"a":2,"e":"Covers gram-negative rods only."}],"pharm-micro:vanco":[{"q":"Vancomycin binds:","o":["Aminoacyl-tRNA site on the 30S subunit","Penicillin-binding proteins (transpeptidases)","D-Ala-D-Ala of cell wall precursors","DNA gyrase (topoisomerase II)"],"a":2,"e":"Resistance: D-Ala-D-Lac (VRE)."},{"q":"Daptomycin should not be used for:","o":["S. aureus bacteremia","Complicated skin and soft-tissue infection","Community-acquired pneumonia","Right-sided endocarditis"],"a":2,"e":"Inactivated by pulmonary surfactant. Monitor CK for myopathy."}],"pharm-micro:aminogly":[{"q":"Aminoglycoside toxicities:","o":["Cardiotoxicity and QT prolongation","Hepatotoxicity and pancreatitis","Nephrotoxicity and ototoxicity","Photosensitivity and tooth staining"],"a":2,"e":"Also neuromuscular blockade; teratogenic."},{"q":"Aminoglycosides are ineffective against anaerobes because:","o":["Uptake requires O₂-dependent transport","They bind 50S","They need low pH","They are destroyed by anaerobes"],"a":0,"e":"Synergy with β-lactams."}],"pharm-micro:tetra":[{"q":"Tetracyclines should not be taken with:","o":["Acetaminophen or ibuprofen","Milk, antacids or iron supplements","Plain water while sitting upright","Vitamin C or orange juice"],"a":1,"e":"Divalent/trivalent cations chelate the drug → ↓ absorption."},{"q":"Tetracyclines are avoided in children because of:","o":["Kernicterus from bilirubin displacement off albumin","Tooth discoloration and impaired bone growth","Gray baby syndrome and circulatory collapse","Ototoxicity and vestibular damage"],"a":1,"e":"Also photosensitivity."}],"pharm-micro:macro":[{"q":"Macrolides can cause:","o":["Red man syndrome with rapid infusion","QT prolongation and ↑ GI motility","Achilles tendon rupture in the elderly","Gray baby syndrome in neonates"],"a":1,"e":"Erythromycin inhibits CYP3A4."},{"q":"Clindamycin is associated with:","o":["Achilles tendon rupture","Hemolysis in G6PD deficiency","C. difficile colitis","Irreversible ototoxicity"],"a":2,"e":"Good anaerobic coverage above the diaphragm."}],"pharm-micro:linezolid":[{"q":"Linezolid adverse effects include:","o":["Tendon rupture and photosensitivity reactions","Nephrotoxicity and ototoxicity","Gray baby syndrome and kernicterus","Myelosuppression and serotonin syndrome"],"a":3,"e":"Weak MAO inhibition."},{"q":"Chloramphenicol in neonates causes:","o":["Permanent tooth staining","Gray baby syndrome","Neonatal kernicterus","Neonatal Reye syndrome"],"a":1,"e":"Lack of UDP-glucuronosyltransferase."}],"pharm-micro:folate":[{"q":"Trimethoprim–sulfamethoxazole can cause:","o":["Hyperkalemia and G6PD hemolysis","Red man syndrome and tendon rupture","Hypokalemia and ototoxicity","Tooth staining and gray baby syndrome"],"a":0,"e":"Also SJS, and kernicterus in neonates."},{"q":"Sulfonamides inhibit:","o":["Dihydropteroate synthase","Dihydrofolate reductase","Thymidylate synthase","DNA gyrase"],"a":0,"e":"Trimethoprim inhibits bacterial DHFR."}],"pharm-micro:fq":[{"q":"Fluoroquinolones are associated with:","o":["Tendon rupture and QT prolongation","Red man syndrome on rapid infusion","Permanent tooth discoloration","Gray baby syndrome and kernicterus"],"a":0,"e":"Avoid in pregnancy and children."},{"q":"Metronidazole with alcohol can cause:","o":["Acute serotonin syndrome","Tyramine hypertensive crisis","Severe hypoglycemia","Disulfiram-like reaction"],"a":3,"e":"Covers anaerobes and protozoa."}],"pharm-micro:tb":[{"q":"Isoniazid adverse effects include:","o":["Red-orange body fluids and CYP induction","Ototoxicity and nephrotoxicity","Hyperuricemia and arthralgia","Peripheral neuropathy and hepatotoxicity"],"a":3,"e":"Give pyridoxine (B6). Ethambutol: optic neuritis; rifampin: orange fluids; pyrazinamide: hyperuricemia."},{"q":"Rifampin is a potent:","o":["DHFR inhibitor","CYP450 inhibitor","MAO inhibitor","CYP450 inducer"],"a":3,"e":"Reduces efficacy of warfarin, contraceptives."}],"pharm-micro:prophylaxis":[{"q":"Pneumocystis prophylaxis in HIV begins at CD4 <:","o":["500 cells/mm³","100 cells/mm³","200 cells/mm³","50 cells/mm³"],"a":2,"e":"TMP-SMX."},{"q":"Prophylaxis for MAC in HIV (when not on ART) at CD4 < 50:","o":["TMP-SMX","Ganciclovir","Azithromycin","Fluconazole"],"a":2,"e":"Not needed if ART started promptly."}],"pharm-micro:fungmap":[{"q":"Amphotericin B binds:","o":["β-glucan synthase in the cell wall","Lanosterol 14α-demethylase (CYP51)","Fungal microtubules (tubulin)","Ergosterol, forming membrane pores"],"a":3,"e":"Nephrotoxic; hypokalemia and hypomagnesemia."},{"q":"Echinocandins (caspofungin) inhibit:","o":["Ergosterol synthesis","Nucleic acid synthesis","Microtubules","β-glucan